    def plan_screen(self, scr, accepted, dropped, shown, total, dest, disks, history=None):
        """The plan and the disks. Nothing is removed on this screen."""
        import curses
        live = [row for row in accepted if row.get("action") in ("delete", "quarantine")]
        dropped_live = list(dropped)
        cursor = 0
        follow = None
        self._plan_top = 0
        while True:
            deletes, delete_size, quarantines, quarantine_size, dropped_rows = self.plan_groups(
                live, dropped_live)
            groups = []
            if deletes:
                groups.append(("delete", "[D]", _("Delete"), deletes, delete_size))
            if quarantines:
                groups.append(("quarantine", "[Q]", _("Quarantine"), quarantines, quarantine_size))
            if dropped_rows:
                groups.append(("drop", "[-]", _("Dropped"), dropped_rows, None))
            items = [row for _kind, _tag, _title, rows, _size in groups for row in rows]
            if follow:
                for index, row in enumerate(items):
                    if row.get("path") == follow:
                        cursor = index
                        break
                follow = None
            h, w = scr.getmaxyx()
            scr.erase()
            if h < 8 or w < 40:
                scr.addnstr(0, 0, _("Terminal too small"), max(w - 1, 1))
                scr.refresh()
                scr.getch()
                return
            scr.addnstr(0, 0, (_(" ncdu-clean · suggestion") + " · " + self.scan_name).ljust(w - 1),
                        w - 1, curses.A_REVERSE)
            if shown < total:
                sub = _(" {shown} of {total}, largest first").format(shown=shown, total=total)
            else:
                sub = _(" {n} entries").format(n=shown)
            scr.addnstr(1, 0, sub.ljust(w - 1), w - 1, curses.A_BOLD)
            pinned = [" " + _("Disks")]
            disk_lines, more = disk_rows(
                disks, 4, scan_root=normalize(info_of(self.root)["name"]))
            pinned.extend(disk_lines or [" " + _("No disk found.")])
            if more:
                pinned.append(" " + _("{n} more").format(n=more))
            pinned.append(_(" Quarantine folder: {path}").format(path=dest["path"]))
            detail = []
            if dest.get("create"):
                detail.append(_("This folder will be created."))
            if dest.get("same_disk"):
                detail.append(_("Same disk: this does not free space."))
            elif dest.get("mount"):
                detail.append(_("{free} free on {mount}.").format(
                    free=human(dest.get("free", 0)), mount=dest["mount"]))
                if quarantine_size > dest.get("free", 0):
                    detail.append(_("The quarantine is larger than the free space."))
            if dest.get("kind") == "removable":
                detail.append(_("Removable disk."))
            if dest.get("reason"):
                detail.append(dest["reason"])
            if detail:
                pinned.append(" " + "  ".join(detail))
            if history:
                pinned.append(_(" Reflection: {path}").format(path=history))
            pinned = pinned[:max(4, h - 10)]
            for i, line in enumerate(pinned):
                scr.addnstr(2 + i, 0, self._fit(line, w - 1).ljust(w - 1), w - 1,
                            curses.A_BOLD if i == 0 else curses.A_NORMAL)
            body_top = 2 + len(pinned)
            body_h = max(h - body_top - 2, 1)
            rendered = []
            biggest = max((row.get("size", 0) for row in items), default=1) or 1
            cursor = max(0, min(cursor, len(items) - 1)) if items else 0
            seen = 0
            for kind, tag, title, rows, size in groups:
                if rendered:
                    rendered.append((None, "", curses.A_NORMAL))
                label = " " + title
                if size is not None:
                    label += "  " + human(size)
                attr = curses.A_BOLD
                pair = {"delete": 1, "quarantine": 2, "drop": 3}[kind]
                if HAS_COLOR:
                    attr |= curses.color_pair(pair)
                rendered.append((None, label, attr))
                for row in rows:
                    selected = seen == cursor
                    bar_n = int(round(10 * row.get("size", 0) / biggest)) if size is not None else 0
                    bar = "#" * bar_n
                    size_text = human(row.get("size", 0)) if size is not None else " " * 9
                    prefix = f" {tag} {size_text:>9} [{bar:<10}] "
                    path = self._fit(row.get("path") or "—", max(w - len(prefix) - 1, 1))
                    line_attr = curses.A_REVERSE if selected else curses.A_NORMAL
                    if HAS_COLOR and not selected:
                        line_attr |= curses.color_pair(pair)
                    rendered.append((seen, prefix + path, line_attr))
                    reason = (row.get("reason") or "").strip()
                    if reason:
                        reason_attr = curses.A_REVERSE if selected else curses.A_DIM
                        rendered.append((seen, " " * len(prefix) + self._fit(reason, max(w - len(prefix) - 1, 1)),
                                         reason_attr))
                    seen += 1
            start = 0
            for index, (owner, _text, _attr) in enumerate(rendered):
                if owner == cursor:
                    start = index
                    break
            span = 1
            if start + 1 < len(rendered) and rendered[start + 1][0] == cursor:
                span = 2
            if start < self._plan_top:
                self._plan_top = start
            if start + span - 1 >= self._plan_top + body_h:
                self._plan_top = start + span - body_h
            self._plan_top = max(0, min(self._plan_top, max(len(rendered) - body_h, 0)))
            for i, (_owner, text, attr) in enumerate(rendered[self._plan_top:self._plan_top + body_h]):
                scr.addnstr(body_top + i, 0, text.ljust(w - 1), w - 1, attr)
            status = [_("Plan ready.")]
            if deletes:
                status.append(_("Delete frees {size}.").format(size=human(delete_size)))
            if quarantines:
                status.append(_("Quarantine sets aside {size}.").format(size=human(quarantine_size)))
            scr.addnstr(h - 2, 0, (" " + "  ·  ".join(status)).ljust(w - 1), w - 1, curses.A_BOLD)
            scr.addnstr(h - 1, 0, _(" arrows    F1 help    q quits").ljust(w - 1), w - 1)
            scr.refresh()
            k = scr.getch()
            if k in (curses.KEY_DOWN, ord("j")) and items:
                cursor = min(cursor + 1, len(items) - 1)
            elif k in (curses.KEY_UP, ord("k")) and items:
                cursor = max(cursor - 1, 0)
            elif k == curses.KEY_NPAGE and items:
                cursor = min(cursor + max(body_h // 2, 1), len(items) - 1)
            elif k == curses.KEY_PPAGE and items:
                cursor = max(cursor - max(body_h // 2, 1), 0)
            elif k in (curses.KEY_HOME, ord("g")):
                cursor = 0
            elif k in (curses.KEY_END, ord("G")) and items:
                cursor = len(items) - 1
            elif k in (curses.KEY_F1, ord("?")):
                self.show_help(scr, self.plan_help_lines())
            elif k == ord("t") and items:
                row = items[cursor]
                if row.get("action") == "delete":
                    row["action"] = "quarantine"
                    follow = row.get("path")
                elif row.get("action") == "quarantine":
                    row["action"] = "delete"
                    follow = row.get("path")
            elif k == ord("-") and items:
                row = items[cursor]
                if row.get("action") in ("delete", "quarantine"):
                    path = row.get("path")
                    live = [item for item in live if item.get("path") != path]
                    dropped_live.append({"path": path, "reason": _("taken out of the plan")})
                    follow = path
            elif k == ord("d") and deletes:
                self._ack(scr, _("d received. Nothing is deleted until you type yes."))
                if self.run_suggested(scr, deletes, None):
                    gone = {row["path"] for row in deletes}
                    live = [row for row in live if row["path"] not in gone]
                    if not live:
                        self.msg = _("Done. Nothing else from this suggestion.")
                        return
            elif k == ord("m") and quarantines:
                self._ack(scr, _("m received. Nothing is moved until you type yes."))
                if self.run_suggested(scr, quarantines, dest["path"]):
                    gone = {row["path"] for row in quarantines}
                    live = [row for row in live if row["path"] not in gone]
                    if not live:
                        self.msg = _("Done. Nothing else from this suggestion.")
                        return
            elif k in (ord("q"), 27):
                quit_now()
            elif k in (10, 13, curses.KEY_ENTER, ord("x")):
                self.msg = _("Nothing was deleted.")
                return

    def _ack(self, scr, text):
        import curses
        h, w = scr.getmaxyx()
        scr.addnstr(h - 2, 0, (" " + text).ljust(max(w - 1, 1)), max(w - 1, 1), curses.A_REVERSE)
        scr.refresh()

    def _take_suggestion(self, rows, label):
        mark_rows(self.marked, self.root, rows)
        self.save()
        self.msg = _("suggestion marked ({n} {action}). Review them, then x.") \
            .format(n=len(rows), action=label)

    def draw(self, scr):
        import curses
        if not self.disk:
            self.recompute()
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 6 or w < 40:
            scr.addnstr(0, 0, _("Terminal too small"), max(w - 1, 1))
            scr.refresh()
            return
        rows = self.entries()
        n, body = len(rows), h - 4
        self.cursor = max(0, min(self.cursor, n - 1)) if n else 0
        if self.cursor < self.top:
            self.top = self.cursor
        if self.cursor >= self.top + body:
            self.top = self.cursor - body + 1
        mode = _("file size") if self.apparent else _("disk usage")
        sort = _("name") if self.sort == "name" else _("size")
        scr.addnstr(0, 0, _(" ncdu-clean · {name} · size: {mode} (a: switch) · sort: {sort}")
                    .format(name=self.scan_name, mode=mode, sort=sort).ljust(w - 1),
                    w - 1, curses.A_REVERSE)
        scr.addnstr(1, 0, f" {self.cwd}", w - 1, curses.A_BOLD)
        biggest = max((r[4] for r in rows), default=0) or 1
        if not rows:
            scr.addnstr(2, 2, _("(empty directory)"), w - 3)
        for i, (name, path, node, is_dir, size) in enumerate(rows[self.top:self.top + body]):
            st = self.state(path)
            box = {"direct": "[*]", "covered": "[+]"}.get(st, "[ ]")
            bar = "#" * int(round(10 * size / biggest))
            line = f" {box} {human(size):>9} [{bar:<10}] {name}{'/' if is_dir else ''}"
            attr = curses.A_NORMAL
            if HAS_COLOR:
                attr |= curses.color_pair(1 if st == "direct" else 2 if st == "covered"
                                          else 3 if is_dir else 0)
            if st == "direct":
                attr |= curses.A_BOLD
            if self.top + i == self.cursor:
                attr |= curses.A_REVERSE
            scr.addnstr(2 + i, 0, line.ljust(w - 1), w - 1, attr)
        status = _(" {count} marked, {size}").format(count=len(self.marked),
                                                    size=human(self.marked_size()))
        if self.marked:
            status += _("  (x: act on them)")
        if self.msg:
            status += f"   · {self.msg}"
        scr.addnstr(h - 2, 0, status.ljust(w - 1), w - 1, curses.A_BOLD)
        scr.addnstr(h - 1, 0, _(" arrows/Enter navigate · Space mark · p suggest · x act · "
                                "c clear · s/n sort · a size · ? help · q quit"), w - 1)
        scr.refresh()

    def show_help(self, scr, lines=None):
        scr.erase()
        h, w = scr.getmaxyx()
        lines = self.help_lines() if lines is None else lines
        for i, line in enumerate(lines[:h - 2]):
            scr.addnstr(i + 1, 2, line, max(w - 3, 1))
        scr.addnstr(min(len(lines) + 2, h - 1), 2, _("(press any key to go back)"), max(w - 3, 1))
        scr.refresh()
        scr.getch()

    def run(self, scr):
        import curses
        scr.nodelay(False)
        while True:
            self.draw(scr)
            k = scr.getch()
            h = scr.getmaxyx()[0]
            rows = self.entries()
            self.msg = ""
            if k == ord("q"):
                if self.hard_quit:
                    quit_now()
                return
            elif k in (curses.KEY_DOWN, ord("j")):
                self.cursor += 1
            elif k in (curses.KEY_UP, ord("k")):
                self.cursor -= 1
            elif k == curses.KEY_NPAGE:
                self.cursor += h - 4
            elif k == curses.KEY_PPAGE:
                self.cursor -= h - 4
            elif k in (curses.KEY_HOME, ord("g")):
                self.cursor = 0
            elif k in (curses.KEY_END, ord("G")):
                self.cursor = len(rows) - 1
            elif k in (curses.KEY_RIGHT, ord("l"), 10, 13, curses.KEY_ENTER):
                if rows and rows[self.cursor][3]:
                    self.saved_pos.append((self.cursor, self.top))
                    self.stack.append(rows[self.cursor][2])
                    self.parts.append(rows[self.cursor][0])
                    self.cursor = self.top = 0
            elif k in (curses.KEY_LEFT, ord("h"), curses.KEY_BACKSPACE, 127, 8):
                if len(self.stack) > 1:
                    self.stack.pop()
                    self.parts.pop()
                    self.cursor, self.top = self.saved_pos.pop()
            elif k == ord(" "):
                if rows:
                    _name, path, node, _isdir, _size = rows[self.cursor]
                    self.toggle(path, node)
                    self.cursor += 1
            elif k == ord("p"):
                if not os.environ.get("NCDU_CLEAN_AI", "").strip():
                    self.msg = _("NCDU_CLEAN_AI is not set")
                else:
                    self.apply_suggestion(scr)
            elif k == ord("x"):
                self.actions(scr)
            elif k == ord("c"):
                if self.marked:
                    self.msg = _("Clear the whole selection? (y/n)")
                    self.draw(scr)
                    if scr.getch() in (ord("y"), ord("Y"), ord(_("y")[0])):
                        self.marked.clear()
                        self.save()
                        self.msg = _("selection cleared")
                    else:
                        self.msg = ""
            elif k == ord("s"):
                self.sort = "size"
            elif k == ord("n"):
                self.sort = "name"
            elif k == ord("a"):
                self.apparent = not self.apparent
            elif k in (ord("?"), curses.KEY_F1):
                self.show_help(scr)


def write_list(path, marked):
    """Write the list of paths (one per line), atomically."""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as fh:
        for p in sorted(marked):
            fh.write(p + "\n")
    os.replace(tmp, path)


def suggest_ui(a):
    """Interactive suggestion: the export load, the model wait and the plan are separate screens."""
    import curses
    import locale
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    os.environ.setdefault("ESCDELAY", "25")

    def main(scr):
        setup_curses()
        screen = LoadScreen(
            scr, os.path.basename(a.export),
            note=_("Reading the export. The model is not called yet."))
        try:
            root = load_export(a.export, screen)
        except Aborted:
            return None
        browser = Browser(root, os.path.basename(a.export), None, default_log())
        browser.hard_quit = True
        browser.present_suggestion(scr, a.delete_list, a.quarantine_list)
        browser.run(scr)
        return browser

    try:
        browser = curses.wrapper(main)
    except ExportError as e:
        die(str(e))
    if browser is None:
        print(_("Aborted."))
    elif browser.marked:
        print(_("{paths} marked but not processed: nothing was done. "
                "(In the browser, x lets you act; -o FILE keeps the selection.)")
              .format(paths=fmt_paths(len(browser.marked))))
    return 0


def run_browser(root, export_name, out, log_path, marked_rows=None, message="",
                suggestion=None, failure=None, job=None):
    """Open the browser on an export already loaded. Nothing is removed here."""
    import curses
    import locale
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    os.environ.setdefault("ESCDELAY", "25")

    def main(scr):
        setup_curses()
        b = Browser(root, export_name, out, log_path or default_log())
        if marked_rows:
            mark_rows(b.marked, root, marked_rows)
            b.save()
        if job:
            job(b, scr)
        elif failure:
            b.notice_screen(scr, failure.splitlines())
        elif suggestion:
            accepted, dropped, shown, total = suggestion
            b.plan_screen(scr, accepted, dropped, shown, total)
        elif message:
            b.msg = message.split("\n", 1)[0]
        b.run(scr)
        return b

    try:
        b = curses.wrapper(main)
    except KeyboardInterrupt:
        return 2
    if b and b.marked and not out:
        print(_("{paths} marked but not processed: nothing was done. "
                "(In the browser, x lets you act; -o FILE keeps the selection.)")
              .format(paths=fmt_paths(len(b.marked))))
    return 0


def cmd_browse(a):
    import curses
    import locale
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die(_("browse needs an interactive terminal"))
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass  # locale not generated on this system: keep the default
    os.environ.setdefault("ESCDELAY", "25")

    def main(scr):
        setup_curses()
        screen = LoadScreen(scr, os.path.basename(a.export))
        try:
            root = load_export(a.export, screen)
            screen.draw(_("Computing sizes…"), None, [], hint=False)
            b = Browser(root, os.path.basename(a.export), a.out, a.log or default_log())
            if a.out and os.path.exists(a.out):
                with open(a.out, "rb") as fh:
                    b.load_marked([normalize(os.fsdecode(x)) for x in fh.read().split(b"\n") if x])
        except Aborted:
            return None
        b.run(scr)
        return b

    try:
        b = curses.wrapper(main)
    except ExportError as e:
        die(str(e))
    if b is None:
        print(_("Aborted."))
    elif b.marked:
        if a.out:
            print(_("{paths} still marked, kept in {name}").format(
                paths=fmt_paths(len(b.marked)), name=a.out))
        else:
            print(_("{paths} marked but not processed: nothing was done. "
                    "(In the browser, x lets you act; -o FILE keeps the selection.)")
                  .format(paths=fmt_paths(len(b.marked))))
    return 0


# --- command line --------------------------------------------------------------

def build_parser():
    description = _(
        "ncdu-clean: delete files found with ncdu, and keep a record of what was removed.\n"
        "\n"
        "Commands:\n"
        "  browse EXPORT   browse like ncdu, mark items, then choose what to do with them\n"
        "  suggest EXPORT  ask $NCDU_CLEAN_AI for a delete / quarantine plan\n"
        "  rm PATH...      delete (or quarantine) after checks, and journal it (for scripts)\n"
        "  log             show the journal of deletions\n"
        "  restore [RUN]   list quarantine runs, or put them back where they came from\n"
        "  list EXPORT     flat list, biggest first (for scripts, fzf...)\n"
        "\n"
        "Typical workflow:\n"
        "  ncdu -e -o scan.json /var       # 1. scan (-e adds modification dates)\n"
        "  ncdu-clean browse scan.json     # 2. Space: mark; x: choose (delete / quarantine / list)\n"
        "  ncdu-clean log                  # 3. find out what was deleted\n"
        "  ncdu-clean restore              # 4. undo a quarantine, in whole or in part\n")
    epilog = _("Default journal: ~/.local/state/ncdu-clean/deleted.jsonl "
               "(/var/log/ncdu-clean.jsonl for root), or $NCDU_CLEAN_LOG.")
    p = argparse.ArgumentParser(prog="ncdu-clean", description=description, epilog=epilog,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"ncdu-clean {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    br = sub.add_parser("browse", help=_("browse an export, mark, then choose what to do"))
    br.add_argument("export")
    br.add_argument("-o", "--out", metavar=_("FILE"),
                    help=_("keep the selection in FILE as you go (optional; reloaded if it exists)"))
    br.add_argument("--log", metavar=_("FILE"), help=_("journal of deletions"))
    br.set_defaults(func=cmd_browse)

    sg = sub.add_parser("suggest", help=_("ask for a delete / quarantine plan"))
    sg.add_argument("export")
    sg.add_argument("--delete-list", metavar=_("FILE"),
                    help=_("write the paths to delete, one per line"))
    sg.add_argument("--quarantine-list", metavar=_("FILE"),
                    help=_("write the paths to quarantine, one per line"))
    sg.set_defaults(func=cmd_suggest)

    ls = sub.add_parser("list", help=_("flat list of the files of an export"))
    ls.add_argument("export")
    ls.add_argument("--dirs", action="store_true", help=_("include directories (cumulative size)"))
    ls.add_argument("--min-size", type=parse_size, default=0, metavar=_("SIZE"),
                    help=_("e.g. 100M"))
    ls.add_argument("--top", type=int, metavar="N", help=_("only the N biggest"))
    ls.add_argument("--apparent", action="store_true", help=_("file size instead of disk usage"))
    ls.add_argument("-0", "--null", action="store_true", help=_("separate lines with NUL"))
    ls.set_defaults(func=cmd_list)

    rm = sub.add_parser("rm", help=_("delete after checks, with journal"))
    rm.add_argument("paths", nargs="*", metavar=_("PATH"))
    rm.add_argument("--from", dest="from_file", metavar=_("FILE"),
                    help=_("read paths from FILE (\"-\" = standard input)"))
    rm.add_argument("-0", "--null", action="store_true", help=_("paths separated by NUL"))
    rm.add_argument("-e", "--export", metavar=_("EXPORT"),
                    help=_("ncdu export, to check nothing changed since the scan"))
    rm.add_argument("-r", "--recursive", action="store_true", help=_("allow non-empty directories"))
    rm.add_argument("--trash", metavar=_("DIR"),
                    help=_("move into DIR/<run>/... instead of deleting"))
    rm.add_argument("--log", metavar=_("FILE"), help=_("journal (default: see below)"))
    rm.add_argument("-y", "--yes", action="store_true", help=_("really act (otherwise simulate)"))
    rm.set_defaults(func=cmd_rm)

    lg = sub.add_parser("log", help=_("show the journal of deletions"))
    lg.add_argument("--log", metavar=_("FILE"))
    lg.add_argument("--grep", metavar=_("TEXT"), help=_("filter on the path"))
    lg.add_argument("--last", type=int, metavar="N", help=_("only the last N lines"))
    lg.set_defaults(func=cmd_log)

    rs = sub.add_parser("restore", help=_("list quarantine runs, or restore them"))
    rs.add_argument("run", nargs="?", metavar=_("RUN"),
                    help=_("run id (or a prefix, or \"last\"); omit to list the runs"))
    rs.add_argument("paths", nargs="*", metavar=_("PATH"),
                    help=_("only restore these original paths (default: the whole run)"))
    rs.add_argument("--log", metavar=_("FILE"), help=_("journal (default: see below)"))
    rs.add_argument("-y", "--yes", action="store_true", help=_("really act (otherwise simulate)"))
    rs.set_defaults(func=cmd_restore)
    return p


def main():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    a = build_parser().parse_args()
    sys.exit(a.func(a) or 0)


if __name__ == "__main__":
    main()
