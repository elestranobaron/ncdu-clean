                        paths=fmt_paths(len(self.marked)), name=name))
                except OSError as e:
                    print(_("Cannot write: {err}").format(err=e.strerror))
            if gone:
                self.after_removal(gone)
            input("\n" + _("Press Enter to go back to the browser..."))
        except (EOFError, KeyboardInterrupt):
            pass
        scr.clear()
        scr.refresh()

    def apply_suggestion(self, scr):
        """Ask NCDU_CLEAN_AI for a plan and show it on this screen. Does not remove anything."""
        self.present_suggestion(scr, None, None)

    def present_suggestion(self, scr, delete_list, quarantine_list):
        import curses
        state = {"phase": "prepare", "cancel": False, "sent": 0, "total": 0, "disks": [],
                 "scan": normalize(info_of(self.root)["name"])}
        holder = {}

        def note_think(text):
            state["think"] = text
            if "think_at" not in state:
                state["think_at"] = time.monotonic()

        def note_think_done(raw):
            try:
                state["think_s"] = float(raw)
            except ValueError:
                state["think_s"] = 0

        def work():
            try:
                state["phase"] = "prepare"
                disks = list_storage()
                state["disks"] = disks
                payload, index, sizes = build_payload(
                    self.root, cancel=lambda: state["cancel"], disks=disks,
                    progress=lambda n: state.__setitem__("counted", n))
                holder["sizes"] = sizes
                state["phase"] = "ask"
                state["sent"] = len(payload["items"])
                state["total"] = payload["total"]
                plan = run_ai(payload, cancel=lambda: state["cancel"],
                              on_text=lambda text: state.__setitem__("reply", text),
                              on_think=note_think,
                              on_think_done=note_think_done,
                              proc_slot=state)
                state["phase"] = "read"
                accepted, dropped = filter_plan(plan, index, self.root)
                need = sum(row.get("size", 0) for row in accepted if row["action"] == "quarantine")
                dest = choose_quarantine_dir(
                    plan.get("quarantine_to") if isinstance(plan, dict) else None,
                    payload["disks"], payload["root"], need, [row["path"] for row in accepted])
                holder["ok"] = (accepted, dropped, state["sent"], state["total"], dest)
            except Exception as exc:
                holder["err"] = exc

        worker = threading.Thread(target=work, daemon=True)
        worker.start()
        started = time.monotonic()
        spin = 0
        note = ""
        scr.timeout(50)
        try:
            while worker.is_alive():
                self._activity(scr, state, time.monotonic() - started, spin, note)
                spin += 1
                key = scr.getch()
                if key in (10, 13, curses.KEY_ENTER):
                    note = _("Enter received. Still working. The file list is not open.")
                elif key in (ord("q"), 27):
                    _stop_proc(state.get("proc"))
                    quit_now()
                elif key not in (-1,):
                    note = _("Key received. Still working. The file list is not open.")
        finally:
            scr.timeout(-1)
        if state.get("cancel"):
            worker.join(0.5)
            append_suggest_history(state.get("think") or "", state.get("reply") or "")
            self.msg = _("Cancelled. Nothing was deleted. This is the file list.")
            return
        worker.join()
        if holder.get("sizes"):
            self.disk, self.app = holder["sizes"]
        history = append_suggest_history(state.get("think") or "", state.get("reply") or "")
        scr.timeout(0)
        while scr.getch() != -1:
            pass
        scr.timeout(-1)
        if "err" in holder:
            err = holder["err"]
            if isinstance(err, SuggestCancelled):
                self.msg = _("Cancelled. Nothing was deleted. This is the file list.")
                return
            if isinstance(err, SuggestError):
                self.notice_screen(scr, explain_failure(err, True).splitlines(),
                                   state.get("reply") or "")
                return
            self.notice_screen(scr, [str(err)])
            return
        accepted, dropped, shown, total, dest = holder["ok"]
        try:
            deletes = [row for row in accepted if row["action"] == "delete"]
            quarantines = [row for row in accepted if row["action"] == "quarantine"]
            if delete_list:
                write_list(delete_list, {row["path"]: None for row in deletes})
            if quarantine_list:
                write_list(quarantine_list, {row["path"]: None for row in quarantines})
        except OSError as e:
            self.notice_screen(scr, [_("Cannot write: {err}").format(err=e.strerror)])
            return
        self.plan_screen(scr, accepted, dropped, shown, total, dest, state["disks"], history)

    def plan_groups(self, accepted, dropped):
        def pack(action):
            rows = sorted((row for row in accepted if row["action"] == action),
                          key=lambda row: row.get("size", 0), reverse=True)
            return rows, sum(row.get("size", 0) for row in rows)

        deletes, delete_size = pack("delete")
        quarantines, quarantine_size = pack("quarantine")
        return deletes, delete_size, quarantines, quarantine_size, list(dropped)

    def _fit(self, text, width):
        text = text.replace("\n", " ")
        if width <= 0:
            return ""
        if len(text) <= width:
            return text
        if width == 1:
            return "…"
        return text[:width - 1] + "…"

    def _activity(self, scr, state, elapsed, spin, note):
        """Full-screen status. A centered box was refreshed away and left a blank wait."""
        import curses
        try:
            h, w = scr.getmaxyx()
            scr.erase()
            if h < 6 or w < 40:
                scr.addnstr(0, 0, _("Terminal too small"), max(w - 1, 1))
                scr.refresh()
                return
            phase = state.get("phase")
            mark = "|/-\\"[spin % 4]
            if phase == "ask" and state.get("think_s") is not None:
                title = _("Writing the plan.")
                detail = _("Thought for {time}.").format(time=fmt_clock(state["think_s"]))
            elif phase == "ask" and state.get("think_at"):
                title = _("Thinking")
                detail = _("Thinking for {time}.").format(
                    time=fmt_clock(time.monotonic() - state["think_at"]))
            elif phase == "ask":
                title = _("Asking the model")
                detail = _("Sent {sent} entries out of {total}. Waiting for the answer.") \
                    .format(sent=state.get("sent", 0), total=state.get("total", 0))
            elif phase == "read":
                title = _("Reading the answer")
                detail = _("The model has answered. Nothing is deleted yet.")
            else:
                title = _("Preparing the summary")
                detail = _("Counting {n} entries. The model is not called yet.") \
                    .format(n=state.get("counted", 0))
            header = _(" ncdu-clean · suggestion") + " · " + self.scan_name \
                + " · " + fmt_clock(elapsed)
            scr.addnstr(0, 0, header.ljust(w - 1), w - 1, curses.A_REVERSE)
            scr.addnstr(2, 0, f" {mark}  {title}".ljust(w - 1), w - 1, curses.A_BOLD)
            scr.addnstr(3, 0, (" " + detail).ljust(w - 1), w - 1)
            reply = state.get("reply") or ""
            if reply:
                label = _("Suggestion")
                view = reply_lines(reply, waiting=(phase == "ask"))
                if phase == "ask" and view:
                    view[-1] += "█"
                scr.addnstr(5, 0, (" " + label).ljust(w - 1), w - 1, curses.A_BOLD)
                room = max(h - 8, 1)
                for i, line in enumerate(view[-room:]):
                    scr.addnstr(6 + i, 0, self._fit(line, w - 1).ljust(w - 1), w - 1)
            else:
                scr.addnstr(4, 0, (" " + _("Nothing is deleted.")).ljust(w - 1), w - 1)
                if phase == "ask" and not state.get("think_at"):
                    scr.addnstr(5, 0, (" " + _("Waiting for the first word.")).ljust(w - 1),
                                w - 1, curses.A_BOLD)
                scr.addnstr(7, 0, (" " + _("Disks")).ljust(w - 1), w - 1, curses.A_BOLD)
                lines, more = disk_rows(state.get("disks") or [], max(h - 14, 1),
                                         scan_root=state.get("scan"))
                row = 8
                if not lines:
                    lines = [" " + _("No disk found.")]
                for line in lines:
                    if row >= h - 3:
                        break
                    scr.addnstr(row, 0, self._fit(line, w - 1).ljust(w - 1), w - 1)
                    row += 1
                if more and row < h - 3:
                    scr.addnstr(row, 0, (" " + _("{n} more").format(n=more)).ljust(w - 1), w - 1)
            if note:
                scr.addnstr(h - 2, 0, (" " + note).ljust(w - 1), w - 1, curses.A_REVERSE)
            scr.addnstr(h - 1, 0, _(" q cancels · a key is shown above").ljust(w - 1), w - 1)
            scr.refresh()
        except curses.error:
            pass

    def _panel(self, scr, title, lines, footer=None):
        """Centered box, same family as the loading screen."""
        import curses
        scr.erase()
        h, w = scr.getmaxyx()
        scr.addnstr(0, 0, (_(" ncdu-clean · suggestion") + " · " + self.scan_name).ljust(w - 1),
                    w - 1, curses.A_REVERSE)
        if h < 8 or w < 40:
            scr.addnstr(2, 0, title, max(w - 1, 1))
            scr.refresh()
            return
        width = min(w - 4, 76)
        wrapped = []
        for line in lines:
            wrapped.extend(self._wrap(line, width - 4) or [""])
        height = min(h - 4, max(7, len(wrapped) + 4))
        top = max(2, (h - height) // 2)
        left = (w - width) // 2
        win = curses.newwin(height, width, top, left)
        win.box()
        win.addnstr(0, 2, " " + title + " ", width - 4, curses.A_BOLD)
        for i, line in enumerate(wrapped[:height - 4]):
            win.addnstr(2 + i, 2, line, width - 4)
        bottom = footer if footer is not None else _(" Enter back to the browser")
        scr.addnstr(h - 1, 0, bottom.ljust(w - 1), w - 1)
        scr.noutrefresh()
        win.noutrefresh()
        curses.doupdate()

    def _wrap(self, text, width):
        width = max(width, 8)
        out, cur = [], ""
        for word in text.split():
            if not cur:
                cur = word
            elif len(cur) + 1 + len(word) <= width:
                cur += " " + word
            else:
                out.append(cur)
                cur = word
        if cur:
            out.append(cur)
        return out

    def wait_screen(self, scr, label):
        self._panel(scr, _("Suggestion"), [label])

    def _tail(self, text, width, rows):
        """Last rows of text, broken on the screen width."""
        width = max(width, 8)
        flat = []
        for raw in text.replace("\r", "").split("\n"):
            raw = raw or " "
            while raw:
                flat.append(raw[:width])
                raw = raw[width:]
        return flat[-rows:]

    def notice_screen(self, scr, lines, reply=""):
        """Say why a suggestion failed, then return to the file list."""
        import curses
        if not reply:
            self._panel(scr, _("Suggestion"), lines)
            while True:
                k = scr.getch()
                if k in (10, 13, curses.KEY_ENTER, 27, ord("q"), ord("x"), ord(" ")):
                    self.msg = lines[0] if lines else ""
                    return
            return
        while True:
            try:
                h, w = scr.getmaxyx()
                scr.erase()
                scr.addnstr(0, 0, (_(" ncdu-clean · suggestion") + " · " + self.scan_name).ljust(w - 1),
                            w - 1, curses.A_REVERSE)
                scr.addnstr(2, 0, (" " + _("Suggestion")).ljust(w - 1), w - 1, curses.A_BOLD)
                err_at = max(4, h - 1 - max(len(lines), 1))
                readable = "\n".join(reply_lines(reply))
                for i, line in enumerate(self._tail(readable, max(w - 2, 1), max(err_at - 3, 1))):
                    scr.addnstr(3 + i, 0, (" " + line).ljust(w - 1), w - 1)
                for i, line in enumerate(lines):
                    y = err_at + i
                    if 1 <= y < h - 1:
                        scr.addnstr(y, 0, (" " + self._fit(line, w - 1)).ljust(w - 1), w - 1, curses.A_BOLD)
                scr.addnstr(h - 1, 0, _(" Enter back to the file list").ljust(w - 1), w - 1)
                scr.refresh()
            except curses.error:
                pass
            k = scr.getch()
            if k in (10, 13, curses.KEY_ENTER, 27, ord("q"), ord("x"), ord(" ")):
                self.msg = lines[0] if lines else ""
                return

    def run_suggested(self, scr, rows, trash):
        """Leave the screen, show the simulation, and act only after yes. Return True if they confirmed."""
        import curses
        paths = [row["path"] for row in rows]
        curses.def_prog_mode()
        curses.endwin()
        acted = False
        try:
            print()
            actions = {row.get("action") for row in rows}
            if trash and actions == {"delete"}:
                print(_("These paths were suggested for deletion. They will be moved instead."))
            elif not trash and actions == {"quarantine"}:
                print(_("These paths were suggested for quarantine. They will be deleted instead."))
            run_removal(paths, self.root, True, trash, False, self.log_path, hint=False)
            if trash:
                print(_("Quarantine folder: {path}").format(path=trash))
                if not os.path.isdir(trash):
                    print(_("This folder will be created. The original paths are kept inside it."))
                else:
                    print(_("The original paths are kept inside this folder."))
            answer = input((_("Quarantine {paths}? Type \"{yes}\": ") if trash
                            else _("Delete {paths} permanently? Type \"{yes}\": "))
                           .format(paths=fmt_paths(len(paths)), yes=_("yes"))).strip().lower()
            if answer in (_("yes").lower(), "yes"):
                _rc, gone = run_removal(paths, self.root, True, trash, True, self.log_path)
                if gone:
                    self.after_removal(gone)
                acted = True
            else:
                print(_("Cancelled."))
            input("\n" + _("Press Enter to go back to the browser..."))
        except (EOFError, KeyboardInterrupt):
            print()
        scr.clear()
        scr.refresh()
        return acted

