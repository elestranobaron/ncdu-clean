def cmd_list(a):
    root = load_cli(a.export)
    out = []
    collect(root, None, a.apparent, out)
    rows = [r for r in out if (a.dirs or not r[1]) and r[2] >= a.min_size]
    rows.sort(key=lambda r: r[2], reverse=True)
    if a.top:
        rows = rows[:a.top]
    end = "\0" if a.null else "\n"
    for path, is_dir, size in rows:
        sys.stdout.write(f"{human(size):>10}\t{path}{'/' if is_dir else ''}{end}")


def read_paths(a):
    paths = list(a.paths)
    if a.from_file:
        if a.from_file == "-":
            raw = sys.stdin.buffer.read()
        else:
            try:
                with open(a.from_file, "rb") as fh:
                    raw = fh.read()
            except OSError as e:
                die(_("cannot read {path}: {err}").format(path=a.from_file, err=e.strerror))
        sep = b"\0" if a.null else b"\n"
        paths += [os.fsdecode(x) for x in raw.split(sep) if x]
    return [normalize(p) for p in paths]


def cmd_rm(a):
    paths = read_paths(a)
    if not paths:
        die(_("no path given (arguments or --from)"))
    scan = load_cli(a.export) if a.export else None
    if scan is None:
        warn(_("no --export: freshness is not checked (advised: ncdu -e -o scan.json /path)"))
    rc, _gone = run_removal(paths, scan, a.recursive, a.trash, a.yes, a.log or default_log())
    return rc


# --- suggestion ----------------------------------------------------------------
# NCDU_CLEAN_AI is a command. It reads a JSON summary on stdin and writes a
# JSON plan on stdout. The plan only fills a selection: removal still goes
# through rm or the browser, and still requires yes. The command's environment
# is not copied into the journal.

AI_STDOUT_MAX = 32 << 20
SUGGEST_ITEMS = 40
_SYSTEM_FILES = {"pagefile.sys", "swapfile.sys", "hiberfil.sys"}
_WINDOWS_DIRS = {(), ("system32",), ("syswow64",), ("winsxs",)}


def suggestion_block(path):
    """Reason to keep a path out of a suggestion, or None.

    The browser can still mark it. The suggestion must not offer it."""
    parts = [part for part in path.split("/") if part]
    if not parts:
        return None
    if parts[-1].lower() in _SYSTEM_FILES:
        return _("Windows system file")
    low = [part.lower() for part in parts]
    if "windows" in low:
        rest = tuple(low[low.index("windows") + 1:])
        if rest in _WINDOWS_DIRS:
            return _("Windows system directory")
    if "users" in low:
        rest = low[low.index("users") + 1:]
        if len(rest) <= 1:
            return _("user profile directory")
    return None


class SuggestError(Exception):
    """The suggestion command failed, or its plan is unusable."""


class SuggestCancelled(SuggestError):
    """The user stopped the suggestion while it was still running."""


def fmt_clock(seconds):
    seconds = max(0, int(seconds))
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}"
    return f"{minutes:02d}:{secs:02d}"


_SKIP_FS = {
    "proc", "sysfs", "devtmpfs", "devpts", "cgroup", "cgroup2", "pstore",
    "securityfs", "debugfs", "tracefs", "fusectl", "configfs", "binfmt_misc",
    "autofs", "mqueue", "hugetlbfs", "ramfs", "bpf", "nsfs", "efivarfs",
    "rpc_pipefs", "tmpfs", "squashfs", "overlay",
}


def _unescape_mount(text):
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), text)


def _block_disk(device):
    name = os.path.basename(device)
    if name.startswith(("nvme", "mmcblk")):
        return re.sub(r"p\d+$", "", name)
    return re.sub(r"\d+$", "", name)


def _sys_flag(path):
    try:
        with open(path, encoding="ascii", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def list_storage():
    """Mounted filesystems and disks that are present but not mounted.

    Sizes come from the filesystem for a mount, and from the kernel for a
    disk with nothing mounted. A quarantine can only use a writable mount."""
    rows = []
    mounted_disks = set()
    seen = set()
    try:
        lines = open("/proc/mounts", encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        lines = []
    for line in lines:
        parts = line.split()
        if len(parts) < 3:
            continue
        device, mount, fs = _unescape_mount(parts[0]), _unescape_mount(parts[1]), parts[2]
        if fs in _SKIP_FS or not mount.startswith("/") or mount in seen:
            continue
        seen.add(mount)
        try:
            st = os.statvfs(mount)
        except OSError:
            continue
        total = st.f_frsize * st.f_blocks
        if total <= 0:
            continue
        writable = not bool(st.f_flag & getattr(os, "ST_RDONLY", 1))
        kind = "disk"
        if device.startswith("/dev/"):
            disk = _block_disk(device)
            mounted_disks.add(disk)
            if _sys_flag(f"/sys/block/{disk}/removable") == "1":
                kind = "removable"
        rows.append({
            "mount": mount,
            "device": device,
            "fs": fs,
            "size": total,
            "free": max(st.f_frsize * st.f_bavail, 0),
            "kind": kind,
            "writable": writable,
        })
    try:
        names = sorted(os.listdir("/sys/block"))
    except OSError:
        names = []
    for name in names:
        if name.startswith(("loop", "ram", "fd", "zram", "dm-", "sr")) or name in mounted_disks:
            continue
        sectors = _sys_flag(f"/sys/block/{name}/size")
        try:
            size = int(sectors) * 512
        except ValueError:
            continue
        if size <= 0:
            continue
        removable = _sys_flag(f"/sys/block/{name}/removable") == "1"
        model = _sys_flag(f"/sys/block/{name}/device/model")
        rows.append({
            "mount": "",
            "device": "/dev/" + name,
            "fs": "",
            "size": size,
            "free": 0,
            "kind": "removable" if removable else "unmounted",
            "writable": False,
            "model": model,
        })
    rows.sort(key=lambda row: (not row["mount"], -row["free"], row["mount"] or row["device"]))
    return rows


def mount_of(path, disks):
    """Longest writable mount that contains path."""
    path = normalize(path)
    best = None
    for disk in disks:
        mount = disk.get("mount") or ""
        if not mount:
            continue
        if path == mount or path.startswith(mount.rstrip("/") + "/"):
            if best is None or len(mount) > len(best["mount"]):
                best = disk
    return best


def external_disk(disk):
    """A removable disk or a mount under /media."""
    mount = disk.get("mount") or ""
    return disk.get("kind") == "removable" or mount.startswith(("/media/", "/run/media/"))


def disk_useful(disk):
    """Boot partitions and tiny mounts are not places for a quarantine."""
    mount = disk.get("mount") or ""
    if mount == "/boot" or mount.startswith("/boot/"):
        return False
    if (disk.get("size") or 0) < 512 * 1024 * 1024:
        return False
    return True


def disk_title(disk):
    mount = disk.get("mount") or ""
    if disk.get("kind") == "removable" or mount.startswith("/media/"):
        return _("USB")
    if mount == "/":
        return _("This computer")
    if not mount:
        return (disk.get("model") or disk.get("device") or _("Disk")).strip()
    name = os.path.basename(mount.rstrip("/")) or mount
    if re.fullmatch(r"[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}", name):
        return _("USB")
    return name


def disk_rows(disks, limit=6, scan_root=None):
    """Aligned lines: name, free space, size. Return (lines, how many were left out)."""
    shown = [disk for disk in disks if disk_useful(disk)]
    scan_mount = mount_of(scan_root, disks) if scan_root else None
    lines = ["  {name:<16}{free:>10}  {size:>10}".format(
        name=_("Name"), free=_("Free"), size=_("Size"))]
    for disk in shown[:limit]:
        where = disk.get("mount") or disk.get("device") or ""
        note = ""
        if scan_mount and disk.get("mount") and disk["mount"] == scan_mount.get("mount"):
            note = "  " + _("scan is here")
        elif not disk.get("mount"):
            note = "  " + _("not mounted")
        elif not disk.get("writable"):
            note = "  " + _("read-only")
        free = human(disk.get("free", 0)) if disk.get("mount") else "—"
        lines.append("  {name:<16}{free:>10}  {size:>10}  {where}{note}".format(
            name=disk_title(disk)[:16], free=free, size=human(disk.get("size", 0)),
            where=where, note=note))
    return lines, max(0, len(shown) - limit)


def build_payload(root, cancel=None, disks=None, progress=None):
    """Summary of the export, plus an index of the entries sent to the model."""
    disk, _app = {}, {}
    counted = [0]
    compute_sizes(root, disk, _app, cancel, counted, progress)
    index = {}
    candidates = []

    def walk(node, parent, depth):
        info = info_of(node)
        name = info["name"]
        path = name if parent is None else parent + "/" + name
        is_dir = isinstance(node, list)
        if depth >= 1:
            rec = {
                "path": path,
                "type": "dir" if is_dir else "file",
                "size": disk.get(id(node), 0),
                "node": node,
            }
            if "mtime" in info:
                rec["mtime"] = info["mtime"]
            candidates.append(rec)
        if is_dir and depth < 4:
            for child in children_of(node):
                walk(child, path, depth + 1)

    walk(root, None, 0)
    root_path = info_of(root)["name"]
    if not root_path.startswith("/"):
        root_path = normalize(root_path)

    def depth_of(path):
        extra = path[len(root_path):].strip("/")
        return 0 if not extra else extra.count("/") + 1

    chosen, seen = [], set()
    for level in (1, 2, 3, 4):
        level_rows = [rec for rec in candidates if depth_of(rec["path"]) == level]
        level_rows.sort(key=lambda rec: rec["size"], reverse=True)
        for rec in level_rows:
            if rec["path"] in seen or suggestion_block(rec["path"]):
                continue
            chosen.append(rec)
            seen.add(rec["path"])
            if len(chosen) >= SUGGEST_ITEMS:
                break
        if len(chosen) >= SUGGEST_ITEMS:
            break
    if len(chosen) < SUGGEST_ITEMS:
        files = [rec for rec in candidates if rec["type"] == "file"]
        files.sort(key=lambda rec: rec["size"], reverse=True)
        for rec in files:
            if rec["path"] in seen:
                continue
            chosen.append(rec)
            seen.add(rec["path"])
            if len(chosen) >= SUGGEST_ITEMS:
                break
    for rec in chosen:
        index[rec["path"]] = rec
    items = [{"path": rec["path"], "type": rec["type"], "size": rec["size"]} for rec in chosen]
    if disks is None:
        disks = list_storage()
    public = []
    for disk_row in [row for row in disks if disk_useful(row)][:24]:
        row = {
            "mount": disk_row.get("mount") or "",
            "device": disk_row.get("device") or "",
            "fs": disk_row.get("fs") or "",
            "size": disk_row.get("size", 0),
            "free": disk_row.get("free", 0),
            "kind": disk_row.get("kind") or "disk",
            "writable": bool(disk_row.get("writable")),
        }
        if disk_row.get("model"):
            row["model"] = disk_row["model"]
        public.append(row)
    return {"root": root_path, "total": max(counted[0] - 1, 0), "items": items, "disks": public}, index, (disk, _app)


def ai_argv():
    raw = os.environ.get("NCDU_CLEAN_AI", "").strip()
    if not raw:
        raise SuggestError(_("NCDU_CLEAN_AI is not set"))
    try:
        argv = shlex.split(raw)
    except ValueError as e:
        raise SuggestError(_("NCDU_CLEAN_AI is not a valid command ({err})").format(err=e))
    if not argv:
        raise SuggestError(_("NCDU_CLEAN_AI is not set"))
    return argv


def _split_think(text):
    """Thinking lines are marked by the example client. The rest is the real error.

    THINK_DONE is the signal that thinking has finished, with its duration in seconds."""
    think, err = [], []
    done = None
    for line in text.splitlines():
        if line.startswith("THINK_DONE\t"):
            done = line[11:].strip()
        elif line.startswith("THINK\t"):
            think.append(line[6:])
        elif line.strip():
            err.append(line)
    return "".join(think), "\n".join(err).strip(), done


def quit_now():
    """Restore the terminal and leave. Does not wait for a count or a model."""
    import curses
    try:
        curses.endwin()
    except curses.error:
        pass
    os._exit(0)


def _stop_proc(proc):
    """Kill the suggestion command and close its pipes so readers unblock."""
    if proc is None:
        return
    if proc.poll() is None:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError, OSError):
            try:
                proc.kill()
            except OSError:
                pass
    for stream in (proc.stdin, proc.stdout, proc.stderr):
        if stream is None:
            continue
        try:
            stream.close()
        except OSError:
            pass


def run_ai(payload, cancel=None, on_text=None, on_think=None, on_think_done=None, proc_slot=None):
    """Run NCDU_CLEAN_AI. Return the parsed JSON plan. Never writes the journal.

    cancel() is checked while the command runs. A true result stops it.
    on_text(text) receives the answer as the command writes it.
    on_think(text) receives thinking text the same way."""
    import codecs
    argv = ai_argv()
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    holder = {}

    def pump(stream, on_piece):
        acc = bytearray()
        dec = codecs.getincrementaldecoder("utf-8")("replace")
        shown = []
        try:
            while True:
                block = os.read(stream.fileno(), 256)
                if not block:
                    break
                acc.extend(block)
                piece = dec.decode(block)
                if piece and on_piece:
                    shown.append(piece)
                    on_piece("".join(shown))
            tail = dec.decode(b"", final=True)
            if tail and on_piece:
                shown.append(tail)
                on_piece("".join(shown))
        except Exception as exc:
            holder["err"] = exc
        return bytes(acc)

    def read():
        try:
            proc = subprocess.Popen(
                argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                bufsize=0, start_new_session=True)
        except OSError as e:
            holder["err"] = SuggestError(
                _("cannot run {cmd}: {err}").format(cmd=argv[0], err=e.strerror))
            return
        holder["proc"] = proc
        if proc_slot is not None:
            proc_slot["proc"] = proc
        try:
            proc.stdin.write(data)
            proc.stdin.close()
        except (BrokenPipeError, OSError) as e:
            _stop_proc(proc)
            holder["err"] = SuggestError(_("cannot run {cmd}: {err}").format(cmd=argv[0], err=e))
            return

        def watch_think(text):
            _think, _err, done = _split_think(text)
            if on_think and _think:
                on_think(_think)
            if done is not None and on_think_done:
                on_think_done(done)

        out_box = {}
        err_box = {}

        def take_out():
            out_box["b"] = pump(proc.stdout, on_text)

        def take_err():
            err_box["b"] = pump(proc.stderr, watch_think)

        tout = threading.Thread(target=take_out, daemon=True)
        terr = threading.Thread(target=take_err, daemon=True)
        tout.start()
        terr.start()
        proc.wait()
        tout.join()
        terr.join()
        holder["out"] = out_box.get("b", b"")
        holder["stderr"] = err_box.get("b", b"")

    reader = threading.Thread(target=read, daemon=True)
    reader.start()
    try:
        while reader.is_alive():
            if cancel and cancel():
                proc = holder.get("proc")
                if proc is None:
                    reader.join(0.05)
                    continue
                _stop_proc(proc)
                reader.join(0.3)
                raise SuggestCancelled(_("suggestion cancelled"))
            reader.join(0.05)
    except KeyboardInterrupt:
        _stop_proc(holder.get("proc"))
        reader.join(0.3)
        raise
    if "err" in holder:
        raise holder["err"]
    proc = holder.get("proc")
    out = holder.get("out", b"")
    err = holder.get("stderr", b"")
    if len(out) > AI_STDOUT_MAX:
        raise SuggestError(_("suggestion is too large"))
    if proc.returncode != 0:
        salvaged = salvage_plan(out.decode("utf-8", "replace"))
        _think, text, _done = _split_think(err.decode("utf-8", "replace"))
        if salvaged and "not JSON" in text:
            return salvaged
        tail = text[-2000:] if text else _("exit {code}").format(code=proc.returncode)
        raise SuggestError(_("suggestion command failed: {err}").format(err=tail))
    try:
        return _json_plan(out)
    except (UnicodeError, json.JSONDecodeError) as e:
        raise SuggestError(_("suggestion is not JSON ({err})").format(err=e))


def _field(window, key):
    match = re.search(r'"' + re.escape(key) + r'"\s*:?\s*"((?:\\.|[^"\\])*)"', window)
    if not match:
        return None
    try:
        return json.loads('"' + match.group(1) + '"')
    except json.JSONDecodeError:
        return match.group(1)


def _item_ok(raw):
    """A real plan line. The prompt's example path and action are not one."""
    if not isinstance(raw, dict):
        return False
    path, action = raw.get("path"), raw.get("action")
    if not isinstance(path, str) or not path.startswith("/") or "..." in path:
        return False
    if any(ch in path for ch in "{}\n\t\"'"):
        return False
    return action in ("delete", "quarantine")


def _plan_ok(obj):
    """An items list. Empty is a plan. The prompt example is not."""
    if not isinstance(obj, dict) or not isinstance(obj.get("items"), list):
        return False
    items = obj["items"]
    return not items or any(_item_ok(item) for item in items)


def _prose_plan(text):
    """Decisions written as '/path: Delete' when the model never reaches JSON."""
    found = {}
    pattern = re.compile(
        r"(/[^`\n\"']{1,240}?)\s*`?\s*(?:\([^)]{0,48}\))?\s*(?::|->)\s*([^\n]{0,48})",
        re.IGNORECASE)
    for match in pattern.finditer(text):
        path = match.group(1).strip().strip("`\"'").rstrip(".,;")
        if not _item_ok({"path": path, "action": "delete"}):
            continue
        window = match.group(2)
        head = re.match(
            r"\s*(?:\*\*)?(delete|quarantine)\b(?:\s+or\s+(delete|quarantine)\b)?",
            window, re.IGNORECASE)
        if not head:
            continue
        words = {head.group(1).lower()}
        if head.group(2):
            words.add(head.group(2).lower())
        action = "quarantine" if "quarantine" in words else "delete"
        found[path] = {"path": path, "action": action, "reason": ""}
    if not found:
        return None
    return {"items": list(found.values())}


def salvage_plan(text):
    """Pull paths out of a reply whose JSON is missing a colon or a comma."""
    if isinstance(text, bytes):
        text = text.decode("utf-8", "replace")
    items, seen = [], set()
    marks = list(re.finditer(r'"path"\s*:?\s*"', text))
    for index, match in enumerate(marks):
        end = marks[index + 1].start() if index + 1 < len(marks) else len(text)
        window = text[match.start():end]
        if '"quarantine_to"' in window[:20]:
            continue
        if "}" not in window:
            continue
        path = _field(window, "path")
        action = _field(window, "action")
        reason = _field(window, "reason") or ""
        if not path or action not in ("delete", "quarantine") or path in seen:
            continue
        if not path.startswith("/") or any(ch in path for ch in "{}\n\t"):
            continue
        seen.add(path)
        items.append({"path": path, "action": action, "reason": reason})
    if not items:
        return _prose_plan(text)
    plan = {"items": items}
    at = text.find('"quarantine_to"')
    if at >= 0:
        window = text[at:at + 400]
        folder = _field(window, "path")
        if folder and "}" in window:
            plan["quarantine_to"] = {
                "path": folder,
                "create": True,
                "reason": _field(window, "reason") or "",
            }
    return plan


def reply_lines(text, waiting=False):
    """The model reply as lines: action, path, reason. No raw JSON."""
    plan = salvage_plan(text) or {}
    lines = []
    for item in plan.get("items") or []:
        word = _("Delete") if item["action"] == "delete" else _("Quarantine")
        lines.append(f" {word:<12} {item['path']}")
        if item.get("reason"):
            lines.append(f" {'':12} {item['reason']}")
    folder = (plan.get("quarantine_to") or {}).get("path")
    if folder:
        lines.append(" " + _("Folder") + "  " + folder)
    if not lines and waiting:
        return [" " + _("Writing the plan.")]
    return lines


def _json_plan(raw):
    """The answer may arrive as raw model text. Take the JSON object out of it."""
    text = raw.decode("utf-8", "replace").strip()
    if text.startswith("```"):
        lines = text.splitlines()[1:]
        if lines and lines[-1].strip().startswith("```"):
            lines = lines[:-1]
        text = "\n".join(lines).strip()
    decoder = json.JSONDecoder()
    start = 0
    while True:
        brace = text.find("{", start)
        if brace < 0:
            break
        try:
            found, end = decoder.raw_decode(text, brace)
        except json.JSONDecodeError:
            start = brace + 1
            continue
        if _plan_ok(found):
            return found
        start = end if end > brace else brace + 1
    salvaged = salvage_plan(text)
    if salvaged:
        return salvaged
    raise json.JSONDecodeError("no plan", text, 0)


def _drop(dropped, path, reason):
    dropped.append({"path": path, "reason": reason})


def filter_plan(plan, index, root):
    """Keep paths that are in the export. Drop the rest, and drop overlaps."""
    if not isinstance(plan, dict) or not isinstance(plan.get("items"), list):
        raise SuggestError(_("suggestion must be a JSON object with an \"items\" list"))
    root_path = normalize(info_of(root)["name"])
    home = normalize(os.path.expanduser("~"))
    by_path = {}
    dropped = []
    for raw in plan["items"]:
        if not isinstance(raw, dict):
            _drop(dropped, "", _("not an object"))
            continue
        path = raw.get("path")
        action = raw.get("action")
        reason = raw.get("reason", "")
        if not isinstance(path, str) or not path.strip():
            _drop(dropped, "", _("missing path"))
            continue
        path = normalize(path)
        if "\n" in path or "\x00" in path:
            _drop(dropped, path, _("name contains a newline: not supported"))
            continue
        if action not in ("delete", "quarantine"):
            _drop(dropped, path, _("action must be delete or quarantine"))
            continue
        if path not in index:
            _drop(dropped, path, _("not in the export (created since the scan, or outside it)"))
            continue
        if path.count("/") <= 1:
            _drop(dropped, path, _("top-level path (/, /etc, /var...): refused on principle"))
            continue
        if path == home:
            _drop(dropped, path, _("this is your home directory"))
            continue
        if path == root_path:
            _drop(dropped, path, _("this is the root of the scan"))
            continue
        blocked = suggestion_block(path)
        if blocked:
            _drop(dropped, path, blocked)
            continue
        if not isinstance(reason, str):
            reason = ""
        reason = " ".join(reason.split())[:200]
        prev = by_path.get(path)
        if prev is None:
            by_path[path] = {"path": path, "action": action, "reason": reason,
                             "size": index[path]["size"]}
        elif prev is False or prev["action"] != action:
            _drop(dropped, path, _("conflicts with another action"))
            by_path[path] = False
        else:
            _drop(dropped, path, _("duplicate"))
    by_path = {p: v for p, v in by_path.items() if v}
    # A directory and a descendant with two actions: drop the directory.
    # Deleting or quarantining it would also take the descendant.
    while True:
        victim = None
        for path, row in by_path.items():
            prefix = path + "/"
            for other_path, other in by_path.items():
                if other_path.startswith(prefix) and other["action"] != row["action"]:
                    victim = (path, other_path)
                    break
            if victim:
                break
        if not victim:
            break
        path, other_path = victim
        _drop(dropped, path, _("conflicts with {path}").format(path=other_path))
        del by_path[path]
    for path in sorted(by_path, key=len, reverse=True):
        if path not in by_path:
            continue
        parent = os.path.dirname(path)
        while parent and parent != "/":
            other = by_path.get(parent)
            if other and other["action"] == by_path[path]["action"]:
                _drop(dropped, path, _("covered by {path}").format(path=parent))
                del by_path[path]
                break
            parent = os.path.dirname(parent)
    accepted = [by_path[p] for p in sorted(by_path)]
    return accepted, dropped


def choose_quarantine_dir(raw, disks, scan_root, need, forbidden):
    """A folder on a known writable disk, large enough when the move copies.

    The model's folder is kept when it sits on such a disk and does not overlap
    a path in the plan. A removable disk comes first: a folder on the scan disk
    is not kept while one is mounted. Otherwise the writable disk with the most
    free space, other than the scan's disk, is used. One folder: the original
    paths are kept inside it."""
    if isinstance(raw, str):
        raw = {"path": raw, "create": True, "reason": ""}
    mounts = [disk for disk in disks if disk.get("mount") and disk.get("writable")]
    scan_mount = mount_of(scan_root, mounts) if scan_root else None

    def same_disk(disk):
        return bool(scan_mount and disk["mount"] == scan_mount["mount"])

    def fits(disk):
        if same_disk(disk):
            return True
        return disk.get("free", 0) >= need

    def pack(path, reason, disk):
        exists = os.path.isdir(path)
        return {
            "path": path,
            "create": not exists,
            "reason": reason,
            "same_disk": same_disk(disk),
            "free": disk.get("free", 0),
            "mount": disk["mount"],
            "kind": disk.get("kind") or "disk",
        }

    def fallback():
        externals = [disk for disk in mounts if external_disk(disk)]
        externals.sort(key=lambda disk: disk.get("free", 0), reverse=True)
        if externals:
            path = os.path.join(externals[0]["mount"], "ncdu-clean")
            return pack(path, _("Removable disk with the most free space."), externals[0])
        others = [disk for disk in mounts if fits(disk) and not same_disk(disk)]
        others.sort(key=lambda disk: disk.get("free", 0), reverse=True)
        if others:
            path = os.path.join(others[0]["mount"], "ncdu-clean")
            return pack(path, _("Largest disk with enough free space."), others[0])
        home_disk = mount_of(default_trash(), mounts)
        if home_disk is not None:
            return pack(default_trash(), _("No other disk has enough free space."), home_disk)
        return {
            "path": default_trash(),
            "create": not os.path.isdir(default_trash()),
            "reason": _("No other disk has enough free space."),
            "same_disk": True,
            "free": 0,
            "mount": "",
            "kind": "disk",
        }

    if not isinstance(raw, dict):
        return fallback()
    path = raw.get("path")
    if not isinstance(path, str) or not path.startswith("/"):
        return fallback()
    path = normalize(path)
    if path.count("/") <= 1 or path == normalize(os.path.expanduser("~")):
        return fallback()
    disk = mount_of(path, mounts)
    if disk is None or not fits(disk):
        return fallback()
    if any(external_disk(item) for item in mounts) and not external_disk(disk):
        return fallback()
    for bad in forbidden:
        bad = normalize(bad)
        if path == bad or path.startswith(bad + "/") or bad.startswith(path + "/"):
            return fallback()
    if os.path.lexists(path) and not os.path.isdir(path):
        return fallback()
    parent = path
    while parent != "/" and not os.path.isdir(parent):
        parent = os.path.dirname(parent)
    if mount_of(parent, mounts) is None or mount_of(parent, mounts)["mount"] != disk["mount"]:
        return fallback()
    reason = raw.get("reason") if isinstance(raw.get("reason"), str) else ""
    reason = " ".join(reason.split())[:200] or _("Suggested folder.")
    return pack(path, reason, disk)


def suggest_plan(root):
    payload, index, _sizes = build_payload(root)
    shown, total = len(payload["items"]), payload["total"]
    plan = run_ai(payload)
    accepted, dropped = filter_plan(plan, index, root)
    need = sum(row.get("size", 0) for row in accepted if row["action"] == "quarantine")
    dest = choose_quarantine_dir(
        plan.get("quarantine_to") if isinstance(plan, dict) else None,
        payload["disks"], payload["root"], need, [row["path"] for row in accepted])
    return accepted, dropped, shown, total, dest


def explain_failure(raw, interactive):
    """Plain reason for a failed suggestion, then what to do next."""
    text = str(raw).strip()
    low = text.lower()
    if "tokenize" in low:
        why = _("The model could not read the request: the text is too long for its context window.")
    elif any(s in low for s in ("unreachable", "connection reset", "timed out", "connection refused")):
        why = _("The model server did not answer. Check the address and the port.")
    elif any(s in low for s in ("returned 500", "returned 502", "returned 503")):
        why = _("The model server failed while reading the request.")
    elif "is not set" in low:
        why = _("No suggestion command is set. Set NCDU_CLEAN_AI to the command that calls the model.")
    elif any(s in low for s in ("not json", "no message", "must be a json")):
        why = _("The model answered, but not with a usable plan.")
    elif any(s in low for s in ("cannot run", "not a valid command", "exit ")):
        why = _("The suggestion command stopped before returning a plan.")
    elif "too large" in low:
        why = _("The model reply is too large to use.")
    else:
        why = text
    if interactive:
        follow = _("Nothing was deleted. Space marks a path, x asks before doing anything.")
    else:
        follow = _("Nothing was deleted. Mark paths yourself with ncdu-clean browse.")
    lines = [why, follow]
    if text and text != why:
        lines.append(_("Detail: {err}").format(err=text[-300:]))
    return "\n".join(lines)


def choose_mark(deletes, quarantines):
    """Ask which action to mark when the plan has both. Return (rows, label)."""
    if deletes and quarantines:
        print()
        print(_("The suggestion has both actions. Mark one of them."))
        print(_("  [d] mark the paths to delete ({n})").format(n=len(deletes)))
        print(_("  [q] mark the paths to quarantine ({n})").format(n=len(quarantines)))
        print(_("  [Enter] mark nothing"))
        choice = input("> ").strip().lower()
        if choice == "d":
            return deletes, _("delete")
        if choice == "q":
            return quarantines, _("quarantine")
        return None, ""
    if deletes:
        return deletes, _("delete")
    if quarantines:
        return quarantines, _("quarantine")
    return None, ""


def _print_group(title, rows):
    if not rows:
        return 0
    rows = sorted(rows, key=lambda row: row.get("size", 0), reverse=True)
    total = sum(row.get("size", 0) for row in rows)
    width = max(len(human(row.get("size", 0))) for row in rows)
    print(_("{title}  {size}").format(title=title, size=human(total)))
    for row in rows:
        size = human(row.get("size", 0)).rjust(width)
        reason = row.get("reason") or ""
        print(f"  {size}  {row['path']}" + (f"  {reason}" if reason else ""))
    return total


def show_plan(accepted, dropped):
    """Print the plan with the space of each path. Return (delete rows, quarantine rows)."""
    deletes = [x for x in accepted if x["action"] == "delete"]
    quarantines = [x for x in accepted if x["action"] == "quarantine"]
    delete_size = _print_group(_("Delete"), deletes)
    quarantine_size = _print_group(_("Quarantine"), quarantines)
    if deletes:
        print(_("Delete frees {size}.").format(size=human(delete_size)))
    if quarantines:
        print(_("Quarantine sets aside {size}.").format(size=human(quarantine_size)))
    if dropped:
        print(_("Dropped"))
        for row in dropped:
            print(f"  {row['path'] or '-'}  {row.get('reason', '')}")
    return deletes, quarantines


def mark_rows(marked, root, rows):
    marked.clear()
    for row in rows:
        marked[row["path"]] = find(root, row["path"])


def on_terminal():
    return sys.stdin.isatty() and sys.stdout.isatty()


def cmd_suggest(a):
    if on_terminal():
        return suggest_ui(a)
    root = load_cli(a.export)
    try:
        accepted, dropped, shown, total, dest = suggest_plan(root)
    except SuggestError as e:
        print("ncdu-clean: " + explain_failure(e, False), file=sys.stderr)
        return 2
    deletes = [x for x in accepted if x["action"] == "delete"]
    quarantines = [x for x in accepted if x["action"] == "quarantine"]
    try:
        if a.delete_list:
            write_list(a.delete_list, {x["path"]: None for x in deletes})
        if a.quarantine_list:
            write_list(a.quarantine_list, {x["path"]: None for x in quarantines})
    except OSError as e:
        die(_("Cannot write: {err}").format(err=e.strerror))
    json.dump(
        {"delete": deletes, "quarantine": quarantines, "dropped": dropped,
         "quarantine_to": {"path": dest["path"], "create": dest["create"], "reason": dest["reason"]}},
        sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    print(_("suggestion: {delete} to delete, {quarantine} to quarantine, {dropped} dropped")
          .format(delete=len(deletes), quarantine=len(quarantines), dropped=len(dropped)),
          file=sys.stderr)
    print(_("Quarantine folder: {path}").format(path=dest["path"]), file=sys.stderr)
    return 0


