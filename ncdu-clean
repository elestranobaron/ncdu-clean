# --- translations (gettext) ----------------------------------------------------
# Source strings are English. Catalogues are looked up in $NCDU_CLEAN_LOCALEDIR,
# then in a "locale" directory next to this script, then in the system default
# (/usr/share/locale), which is where the Debian package installs them.

def _localedir():
    env = os.environ.get("NCDU_CLEAN_LOCALEDIR")
    if env:
        return env
    local = os.path.join(os.path.dirname(os.path.realpath(__file__)), "locale")
    return local if os.path.isdir(local) else None


_translation = gettext.translation(DOMAIN, localedir=_localedir(), fallback=True)
_ = _translation.gettext
ngettext = _translation.ngettext
pgettext = _translation.pgettext

UNITS = [pgettext("unit", "B"), pgettext("unit", "KiB"), pgettext("unit", "MiB"),
         pgettext("unit", "GiB"), pgettext("unit", "TiB")]
SIZE_SUFFIX = {"": 1, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}


class Refuse(Exception):
    """A path we refuse to delete (the message says why)."""


class ExportError(Exception):
    """The ncdu export could not be read."""


class Aborted(Exception):
    """The user pressed q while loading."""


def die(msg):
    print(f"ncdu-clean: {msg}", file=sys.stderr)
    sys.exit(2)


def warn(msg):
    print(_("warning: {msg}").format(msg=msg), file=sys.stderr)


def human(n):
    i, n = 0, float(n)
    while n >= 1024 and i < len(UNITS) - 1:
        n /= 1024
        i += 1
    return f"{n:.0f} {UNITS[i]}" if i == 0 else f"{n:.1f} {UNITS[i]}"


def fmt_files(n):
    return ngettext("{n} file", "{n} files", n).format(n=n)


def fmt_paths(n):
    return ngettext("{n} path", "{n} paths", n).format(n=n)


def parse_size(text):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([KMGT]?)(?:i?B)?", text.strip(), re.I)
    if not m:
        raise argparse.ArgumentTypeError(
            _("invalid size: {text!r} (e.g. 100M, 2G)").format(text=text))
    return int(float(m.group(1)) * SIZE_SUFFIX[m.group(2).upper()])


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "ncdu-clean")


def default_log():
    env = os.environ.get("NCDU_CLEAN_LOG")
    if env:
        return env
    if os.geteuid() == 0:
        return "/var/log/ncdu-clean.jsonl"
    return os.path.join(state_dir(), "deleted.jsonl")


def default_trash():
    return os.path.join(state_dir(), "quarantine")


def suggest_history_path():
    return os.path.join(state_dir(), "suggest.log")


def append_suggest_history(think, reply):
    """Append this run's thinking and raw reply. The key is not written."""
    path = suggest_history_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        think = (think or "").strip() or "(no thinking)"
        reply = (reply or "").strip() or "(no reply)"
        with open(path, "a", encoding="utf-8", errors="replace") as fh:
            fh.write(f"\n=== {stamp} ===\n--- think ---\n{think}\n--- reply ---\n{reply}\n")
            fh.flush()
            os.fsync(fh.fileno())
    except OSError:
        return None
    return path


def normalize(path):
    """Absolute, normalised path; symbolic links are not resolved."""
    path = os.path.normpath(os.path.abspath(path))
    return "/" + path.lstrip("/")  # normpath may keep a leading "//"


# --- ncdu export ---------------------------------------------------------------
# Format: [1, 2, {meta}, ROOT]. A directory is a list [{info}, child, ...],
# a file is a plain object {info}.

def info_of(node):
    return node[0] if isinstance(node, list) else node


def children_of(node):
    return node[1:] if isinstance(node, list) else []


_WS = re.compile(r"[ \t\r\n,]*")
_scan_once = json.JSONDecoder().scan_once


def parse_export(text, progress=None):
    """Parse an ncdu export incrementally so that progress can be reported.

    Only [ and ] are handled here; every object is decoded by the json module.
    Costs about 1.7x json.loads, which is worth it for a progress bar."""
    n = len(text)
    ws = _WS.match
    scan = _scan_once
    pos = ws(text, 0).end()
    if pos >= n or text[pos] != "[":
        raise ValueError("not a JSON array")
    pos += 1
    cur, stack = [], []
    items = size = 0
    while True:
        pos = ws(text, pos).end()
        if pos >= n:
            raise ValueError("truncated file")
        c = text[pos]
        if c == "[":
            stack.append(cur)
            cur = []
            pos += 1
        elif c == "]":
            pos += 1
            if not stack:
                if progress:
                    progress("parse", 1.0, items, size, "")
                return cur
            parent = stack.pop()
            parent.append(cur)
            cur = parent
        else:
            try:
                obj, pos = scan(text, pos)
            except StopIteration:
                raise ValueError("invalid JSON at offset %d" % pos)
            cur.append(obj)
            if type(obj) is dict:
                items += 1
                size += obj.get("dsize", 0)
                if progress and not items & 0x3FFF:
                    names = [lst[0].get("name", "") for lst in stack[1:] + [cur]
                             if lst and type(lst[0]) is dict]
                    shown = os.path.join(*names, obj.get("name", "")) if names else ""
                    progress("parse", pos / n, items, size, shown)


def read_text(path, progress=None):
    total = os.path.getsize(path)
    chunks, done = [], 0
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(16 << 20)
            if not chunk:
                break
            chunks.append(chunk)
            done += len(chunk)
            if progress:
                progress("read", done / max(total, 1), 0, 0, "")
    return b"".join(chunks).decode("utf-8", "surrogateescape")


def load_export(path, progress=None):
    """Load an export. progress(phase, fraction, items, size, current) may raise Aborted."""
    try:
        data = parse_export(read_text(path, progress), progress)
    except (OSError, ValueError) as e:
        raise ExportError(_("unreadable export ({path}): {err}").format(path=path, err=e))
    if not (isinstance(data, list) and len(data) >= 4 and data[0] == 1
            and isinstance(data[3], list)):
        raise ExportError(_("{path} does not look like an ncdu export (made with ncdu -o)")
                          .format(path=path))
    root = data[3]
    if not str(info_of(root).get("name", "")).startswith("/"):
        raise ExportError(_("the scan must use an absolute path: ncdu -e -o scan.json /path"))
    return root


class StderrProgress:
    """One-line progress on stderr for the non-interactive commands."""

    def __init__(self):
        self.on = sys.stderr.isatty()
        self.last = 0.0

    def __call__(self, phase, frac, items, size, current):
        if not self.on:
            return
        now = time.monotonic()
        if now - self.last < 0.1 and frac < 1:
            return
        self.last = now
        label = _("Reading file…") if phase == "read" else _("Analysing…")
        sys.stderr.write(f"\r{label} {frac * 100:3.0f}%  "
                         + _("{n} items").format(n=items) + "\033[K")

    def done(self):
        if self.on:
            sys.stderr.write("\r\033[K")


def load_cli(path):
    prog = StderrProgress()
    try:
        return load_export(path, prog)
    except ExportError as e:
        die(str(e))
    finally:
        prog.done()


def find(root, path):
    """Find the export node for an absolute path."""
    base = info_of(root)["name"].rstrip("/")
    if path == (base or "/"):
        return root
    if not path.startswith(base + "/"):
        return None
    node = root
    for part in path[len(base) + 1:].split("/"):
        for child in children_of(node):
            if info_of(child).get("name") == part:
                node = child
                break
        else:
            return None
    return node


def subtree_meta(node, path, out):
    """Fill out with {path: (info, is_dir)} for a whole subtree."""
    info = info_of(node)
    out[path] = (info, isinstance(node, list))
    for child in children_of(node):
        subtree_meta(child, os.path.join(path, info_of(child)["name"]), out)
    return out


def collect(node, parent, apparent, out):
    """Append (path, is_dir, size) for every node; return the node's cumulative size."""
    info = info_of(node)
    path = info["name"] if parent is None else os.path.join(parent, info["name"])
    size = info.get("asize" if apparent else "dsize", 0)
    for child in children_of(node):
        size += collect(child, path, apparent, out)
    out.append((path, isinstance(node, list), size))
    return size


def compute_sizes(node, disk, app, cancel=None, _n=None, progress=None):
    """Cumulative sizes (disk usage / apparent) of every node, keyed by id(node)."""
    if _n is None:
        _n = [0]
    _n[0] += 1
    if _n[0] % 4096 == 0:
        if cancel and cancel():
            raise SuggestCancelled(_("suggestion cancelled"))
        if progress:
            progress(_n[0])
    info = info_of(node)
    d, a = info.get("dsize", 0), info.get("asize", 0)
    for child in children_of(node):
        cd, ca = compute_sizes(child, disk, app, cancel, _n, progress)
        d += cd
        a += ca
    disk[id(node)], app[id(node)] = d, a
    return d, a


# --- disk ----------------------------------------------------------------------

def kind(mode):
    if stat.S_ISDIR(mode):
        return "dir"
    if stat.S_ISLNK(mode):
        return "link"
    return "file" if stat.S_ISREG(mode) else "other"


def walk_disk(path):
    """(path, lstat) of path and everything below it, never following symlinks."""
    st = os.lstat(path)
    yield path, st
    if stat.S_ISDIR(st.st_mode):
        with os.scandir(path) as it:
            for entry in sorted(it, key=lambda e: e.name):
                yield from walk_disk(entry.path)


def check_target(path, scan, recursive, trash):
    """Check that path may be removed. Return (records, verified) or raise Refuse."""
    if path.count("/") <= 1:
        raise Refuse(_("top-level path (/, /etc, /var...): refused on principle"))
    if path == normalize(os.path.expanduser("~")):
        raise Refuse(_("this is your home directory"))
    if trash and (path == trash or trash.startswith(path + "/")):
        raise Refuse(_("the quarantine is inside this path"))
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        raise Refuse(_("does not exist any more"))
    except OSError as e:
        raise Refuse(_("unreadable ({err})").format(err=e.strerror))
    is_dir = stat.S_ISDIR(st.st_mode)

    node = None
    if scan is not None:
        if path == info_of(scan)["name"].rstrip("/"):
            raise Refuse(_("this is the root of the scan"))
        node = find(scan, path)
        if node is None:
            raise Refuse(_("not in the export (created since the scan, or outside it)"))
        info = info_of(node)
        if isinstance(node, list) != is_dir:
            raise Refuse(_("the type changed since the scan"))
        if not is_dir:
            if "mtime" in info and int(st.st_mtime) != info["mtime"]:
                raise Refuse(_("modified since the scan"))
            if st.st_size != info.get("asize", 0):
                raise Refuse(_("size differs from the scan"))

    try:
        entries = list(walk_disk(path))
    except OSError as e:
        raise Refuse(_("unreadable ({err})").format(err=e.strerror))
    if is_dir and len(entries) > 1 and not recursive:
        raise Refuse(_("directory is not empty: add -r"))

    if is_dir and node is not None:
        known = subtree_meta(node, path, {})
        for p, s in entries:
            if p not in known:
                raise Refuse(_("created since the scan: {path}").format(path=p))
            info, _isdir = known[p]
            if not stat.S_ISDIR(s.st_mode):
                if "mtime" in info and int(s.st_mtime) != info["mtime"]:
                    raise Refuse(_("modified since the scan: {path}").format(path=p))
                if s.st_size != info.get("asize", 0):
                    raise Refuse(_("size differs from the scan: {path}").format(path=p))

    recs = [{"path": p, "type": kind(s.st_mode), "size": s.st_size,
             "mtime": int(s.st_mtime)} for p, s in entries]
    return recs, scan is not None


# --- removal (shared by `rm` and the interactive browser) ----------------------

def copy_tree(src, dst, progress):
    """Copy src to dst file by file, then remove src. progress sees each step."""
    files = []
    total = 0
    for dirpath, _dirnames, filenames in os.walk(src, followlinks=False):
        rel = os.path.relpath(dirpath, src)
        os.makedirs(dst if rel == os.curdir else os.path.join(dst, rel), exist_ok=True)
        for name in filenames:
            path = os.path.join(dirpath, name)
            files.append(path)
            try:
                info = os.lstat(path)
                if stat.S_ISREG(info.st_mode):
                    total += info.st_size
            except OSError:
                pass
    done_n = 0
    done_b = 0
    count = len(files)

    def tick(name):
        progress(done_n, count, done_b, total, name)

    for src_file in files:
        rel = os.path.relpath(src_file, src)
        dest_file = os.path.join(dst, rel)
        os.makedirs(os.path.dirname(dest_file), exist_ok=True)
        info = os.lstat(src_file)
        if stat.S_ISLNK(info.st_mode):
            os.symlink(os.readlink(src_file), dest_file)
        elif not stat.S_ISREG(info.st_mode):
            shutil.copy2(src_file, dest_file, follow_symlinks=False)
            done_b += info.st_size
        else:
            with open(src_file, "rb") as inp, open(dest_file, "wb") as out:
                while True:
                    block = inp.read(4 << 20)
                    if not block:
                        break
                    out.write(block)
                    done_b += len(block)
                    tick(rel)
            try:
                shutil.copystat(src_file, dest_file, follow_symlinks=False)
            except OSError:
                pass
        done_n += 1
        tick(rel)
        os.unlink(src_file)
    for dirpath, _dirnames, _filenames in os.walk(src, topdown=False):
        try:
            os.rmdir(dirpath)
        except OSError:
            pass
    tick("")


def move_path(src, dst, progress):
    """Rename when both sides are one disk. Otherwise copy with progress."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    try:
        os.rename(src, dst)
    except OSError as e:
        if e.errno != errno.EXDEV:
            raise
        copy_tree(src, dst, progress)


def journal_sync(logfh, log_path):
    """Flush the journal file and its directory before any removal."""
    logfh.flush()
    os.fsync(logfh.fileno())
    directory = os.path.dirname(os.path.abspath(log_path))
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def run_removal(paths, scan, recursive, trash, yes, log_path, hint=True):
    """Check, then simulate (yes=False) or delete / quarantine (yes=True).

    The journal entry is synced before the removal. Prints everything.
    Returns (exit_code, paths_that_are_gone)."""
    trash = normalize(trash) if trash else None
    dry = not yes
    run = datetime.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    try:
        user = getpass.getuser()
    except Exception:
        user = str(os.getuid())

    logfh = None
    if not dry:  # no journal, no deletion
        try:
            os.makedirs(os.path.dirname(os.path.abspath(log_path)), mode=0o700, exist_ok=True)
            logfh = open(log_path, "a", encoding="utf-8", errors="surrogateescape")
            if trash:
                logfh.write(json.dumps({
                    "event": "trash-run", "ts": now_iso(), "run": run, "user": user,
                    "trash_dir": os.path.join(trash, run)}, ensure_ascii=False) + "\n")
            journal_sync(logfh, log_path)
        except OSError as e:
            print(_("ncdu-clean: journal not writable ({path}: {err}). Nothing was deleted.")
                  .format(path=log_path, err=e.strerror), file=sys.stderr)
            return 2, []

    ok = refused = failed = 0
    total = 0
    gone_paths = []
    painted = {"on": False, "at": 0.0}

    def _move_progress(done_n, count, done_b, total_b, name):
        now = time.monotonic()
        if done_n < count and now - painted["at"] < 0.15:
            return
        painted["at"] = now
        painted["on"] = True
        width = shutil.get_terminal_size((80, 24)).columns
        line = _("  {done}/{count} files   {got} / {size}   {name}").format(
            done=done_n, count=count, got=human(done_b), size=human(total_b), name=name)
        shown = line[:max(width - 1, 1)]
        if sys.stdout.isatty():
            print("\r" + shown.ljust(max(width - 1, 1)), end="", flush=True)
        else:
            print(shown, flush=True)

    for index, path in enumerate(paths, 1):
        try:
            recs, verified = check_target(path, scan, recursive, trash)
        except Refuse as r:
            print(_("REFUSED      {path}: {why}").format(path=path, why=r), file=sys.stderr)
            refused += 1
            continue
        files = [r for r in recs if r["type"] != "dir"]
        size = sum(r["size"] for r in files)
        label = "({files}, {size})".format(files=fmt_files(len(files)), size=human(size))
        if dry:
            print(_("[simulation] {path}  {label}").format(path=path, label=label))
            ok += 1
            total += size
            continue

        ts = now_iso()
        action = "trash" if trash else "delete"
        try:
            for r in recs:
                logfh.write(json.dumps({"ts": ts, "run": run, "user": user,
                                        "action": action, **r,
                                        "verified": verified}, ensure_ascii=False) + "\n")
            journal_sync(logfh, log_path)
        except OSError as e:
            print(_("FAILED       {path}: {why} ({gone}/{count} items gone)").format(
                path=path, why=e.strerror, gone=0, count=len(recs)), file=sys.stderr)
            failed += 1
            continue

        err = None
        try:
            if trash:
                dest = os.path.join(trash, run, path.lstrip("/"))
                print(_("Moving {n}/{total}  {path}").format(
                    n=index, total=len(paths), path=path), flush=True)
                move_path(path, dest, _move_progress)
                if painted["on"]:
                    print()
                    painted["on"] = False
            elif recs[0]["type"] == "dir":
                shutil.rmtree(path) if len(recs) > 1 else os.rmdir(path)
            else:
                os.unlink(path)
        except OSError as e:
            err = e

        gone = [r for r in recs if not os.path.lexists(r["path"])]
        stayed = [r for r in recs if os.path.lexists(r["path"])]
        if stayed:
            ts = now_iso()
            for r in stayed:
                logfh.write(json.dumps({"ts": ts, "run": run, "user": user,
                                        "action": "aborted", **r,
                                        "verified": verified}, ensure_ascii=False) + "\n")
            try:
                journal_sync(logfh, log_path)
            except OSError:
                pass
        gone_paths += [r["path"] for r in gone]

        if err or len(gone) < len(recs):
            print(_("FAILED       {path}: {why} ({gone}/{count} items gone)").format(
                path=path, why=err.strerror if err else _("partial removal"),
                gone=len(gone), count=len(recs)), file=sys.stderr)
            failed += 1
        else:
            word = _("QUARANTINED") if trash else _("DELETED")
            print(f"{word:<12} {path}  {label}")
            ok += 1
            total += size

    if dry:
        verb = _("to delete")
    else:
        verb = _("quarantined") if trash else _("deleted")
    print("\n" + _("{paths} {verb} ({size}), {refused} refused, {failed} failed.").format(
        paths=fmt_paths(ok), verb=verb, size=human(total), refused=refused, failed=failed))
    if dry:
        if hint:
            print(_("Simulation only: add --yes to act."))
    else:
        logfh.close()
        print(_("Journal: {path}").format(path=log_path))
        if trash:
            print(_("Quarantine: {path}  (restore with: ncdu-clean restore {run})")
                  .format(path=os.path.join(trash, run), run=run))
    return (1 if (refused or failed) else 0), gone_paths


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


# --- journal and restore -------------------------------------------------------

def read_journal(path):
    records = []
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            for line in fh:
                try:
                    records.append(json.loads(line))
                except ValueError:
                    continue
    except FileNotFoundError:
        pass
    return records


def trash_runs(records):
    """{run id: {"ts", "trash_dir", "items": {path: record}}} for every quarantine run."""
    runs = {}
    for r in records:
        rid = r.get("run")
        if r.get("event") == "trash-run":
            runs[rid] = {"run": rid, "ts": r.get("ts", ""), "trash_dir": r["trash_dir"],
                         "items": {}}
        elif r.get("action") == "aborted" and "path" in r and rid in runs:
            runs[rid]["items"].pop(r["path"], None)
        elif r.get("action") == "trash" and "path" in r:
            if rid not in runs and r.get("moved_to", "").endswith(r["path"]):
                # journal written by ncdu-clean 0.1: derive the quarantine folder
                runs[rid] = {"run": rid, "ts": r.get("ts", ""), "items": {},
                             "trash_dir": r["moved_to"][:-len(r["path"])]}
            if rid in runs:
                runs[rid]["items"][r["path"]] = r
    return {k: v for k, v in runs.items() if v["items"]}


def top_level(paths):
    """Keep only the paths that have no ancestor in the collection."""
    known = set(paths)
    out = []
    for p in paths:
        q = os.path.dirname(p)
        while q not in ("", "/") and q not in known:
            q = os.path.dirname(q)
        if q in ("", "/"):
            out.append(p)
    return sorted(out)


def restore_tree(src, dst, moved, conflicts):
    """Move src back to dst. Never overwrites: existing directories are merged."""
    if not os.path.lexists(dst):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.move(src, dst)
        moved.append(dst)
    elif (os.path.isdir(src) and not os.path.islink(src)
          and os.path.isdir(dst) and not os.path.islink(dst)):
        for name in sorted(os.listdir(src)):
            restore_tree(os.path.join(src, name), os.path.join(dst, name), moved, conflicts)
        try:
            os.rmdir(src)
        except OSError:
            pass
    else:
        conflicts.append(dst)


def prune_empty(path, stop):
    """Remove empty directories from path up to (and including) stop."""
    while path.startswith(stop) and len(path) >= len(stop):
        try:
            os.rmdir(path)
        except OSError:
            return
        if path == stop:
            return
        path = os.path.dirname(path)


def resolve_run(arg, runs):
    if arg == "last":
        return max(runs, key=lambda k: runs[k]["ts"])
    matches = [k for k in runs if k == arg or k.startswith(arg)]
    if len(matches) == 1:
        return matches[0]
    die(_("unknown or ambiguous run: {run} (list them with: ncdu-clean restore)").format(run=arg))


def run_state(run):
    tdir = run["trash_dir"]
    tops = top_level(list(run["items"]))
    present = [t for t in tops if os.path.lexists(os.path.join(tdir, t.lstrip("/")))]
    if not present:
        return _("nothing left (restored or emptied)")
    if len(present) < len(tops):
        return _("partly restored")
    return _("in quarantine")


def cmd_restore(a):
    log_path = a.log or default_log()
    runs = trash_runs(read_journal(log_path))
    if not runs:
        die(_("no quarantine run found in {path}").format(path=log_path))

    if not a.run:  # list
        c_run, c_date, c_files, c_size, c_state = (_("RUN"), _("DATE"), _("FILES"),
                                                   _("SIZE"), _("STATE"))
        print(f"{c_run:<24} {c_date:<17} {c_files:>7} {c_size:>10}  {c_state}")
        for rid in sorted(runs, key=lambda k: runs[k]["ts"]):
            run = runs[rid]
            files = [r for r in run["items"].values() if r["type"] != "dir"]
            when = run["ts"][:16].replace("T", " ")
            print(f"{rid:<24} {when:<17} {len(files):>7} "
                  f"{human(sum(r['size'] for r in files)):>10}  {run_state(run)}")
        print("\n" + _("Restore a whole run:   ncdu-clean restore RUN --yes"))
        print(_("Restore only some paths: ncdu-clean restore RUN /original/path... --yes"))
        return 0

    rid = resolve_run(a.run, runs)
    run = runs[rid]
    tdir = run["trash_dir"]
    targets = [normalize(p) for p in a.paths] if a.paths else top_level(list(run["items"]))

    plan, missing = [], 0
    for dst in targets:
        src = os.path.join(tdir, dst.lstrip("/"))
        if not os.path.lexists(src):
            print(_("MISSING      {path}: not in the quarantine of this run").format(path=dst),
                  file=sys.stderr)
            missing += 1
        else:
            plan.append((src, dst))

    if not a.yes:
        for src, dst in plan:
            files = [1 for _p, st in walk_disk(src) if not stat.S_ISDIR(st.st_mode)]
            print(_("[simulation] {path}  ({files})").format(path=dst, files=fmt_files(len(files))))
        print("\n" + _("{paths} to restore, {missing} missing.").format(
            paths=fmt_paths(len(plan)), missing=missing))
        print(_("Simulation only: add --yes to act."))
        return 1 if missing else 0

    try:
        os.makedirs(os.path.dirname(os.path.abspath(log_path)), mode=0o700, exist_ok=True)
        logfh = open(log_path, "a", encoding="utf-8", errors="surrogateescape")
    except OSError as e:
        die(_("journal not writable ({path}: {err}). Nothing was restored.")
            .format(path=log_path, err=e.strerror))
    new_run = datetime.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    try:
        user = getpass.getuser()
    except Exception:
        user = str(os.getuid())

    done = conflicts_total = failed = 0
    for src, dst in plan:
        moved, conflicts = [], []
        try:
            restore_tree(src, dst, moved, conflicts)
        except OSError as e:
            print(_("FAILED       {path}: {why}").format(path=dst, why=e.strerror), file=sys.stderr)
            failed += 1
            continue
        finally:
            for top in moved:
                for p, st in walk_disk(top):
                    logfh.write(json.dumps({
                        "ts": now_iso(), "run": new_run, "user": user, "action": "restore",
                        "from_run": rid, "path": p, "type": kind(st.st_mode),
                        "size": st.st_size, "mtime": int(st.st_mtime)}, ensure_ascii=False) + "\n")
            logfh.flush()
            os.fsync(logfh.fileno())
        for c in conflicts:
            print(_("CONFLICT     {path}: already exists, left in quarantine").format(path=c),
                  file=sys.stderr)
        conflicts_total += len(conflicts)
        if moved:
            print(_("RESTORED     {path}").format(path=dst))
            done += 1
            prune_empty(os.path.dirname(src), tdir)
    logfh.close()
    print("\n" + _("{paths} restored, {conflicts} conflicts, {missing} missing, {failed} failed.")
          .format(paths=fmt_paths(done), conflicts=conflicts_total, missing=missing, failed=failed))
    return 1 if (conflicts_total or missing or failed) else 0


def cmd_log(a):
    path = a.log or default_log()
    if not os.path.exists(path):
        die(_("no journal at {path}").format(path=path))
    rows = [r for r in read_journal(path) if "path" in r]
    latest = {}
    for r in rows:
        latest[(r.get("run"), r["path"])] = r
    rows = [r for r in rows
            if latest[(r.get("run"), r["path"])] is r and r.get("action") != "aborted"]
    if a.grep:
        rows = [r for r in rows if a.grep in r["path"]]
    if a.last:
        rows = rows[-a.last:]
    for r in rows:
        mark = "/" if r.get("type") == "dir" else ""
        size = "-" if mark else human(r.get("size", 0))
        print(f"{r['ts']}  {r['action']:<8}  {size:>10}  {r['path']}{mark}")


